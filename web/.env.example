# Frontend (Next.js).
# Leave NEXT_PUBLIC_API_URL blank to auto-target the backend on the same host
# you opened the page from, port 9000 (this is what makes LAN access work).
# Set it only to point at a fixed backend, e.g. http://localhost:9000.
NEXT_PUBLIC_API_URL=http://localhost:9000

# Public address of the frontend (with https://), used for search engine and
# link-preview URLs. Set it in production, before building.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Recipient for the Staff contact form (opens a pre-filled email client).
# Falls back to a placeholder if unset.
NEXT_PUBLIC_STAFF_EMAIL=staff@42roma.it
