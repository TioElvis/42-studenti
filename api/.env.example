# 42-Studenti API (FastAPI) — copy to api/.env and fill in real values.
# NEVER commit api/.env (it is gitignored).

# --- App ---
ENV=development
PORT=9000
# Where to send the browser after a successful 42 login (the Next.js app).
FRONTEND_URL=http://localhost:3000

# --- 42 OAuth2 (Authorization Code flow). The callback URL must match the one
# registered on your 42 application EXACTLY, character for character. Scope: public.
FORTY_TWO_UID=
FORTY_TWO_SECRET=
FORTY_TWO_CALLBACK_URL=http://localhost:9000/auth/42/callback
# 42 Roma campus id on the Intra (used for the public Eventi feed).
FORTY_TWO_CAMPUS_ID=30
# OAuth scopes requested at login. "profile" is required to register the student
# to events on their behalf (POST /v2/events_users). Changing this forces users
# to log in again to re-consent.
OAUTH_SCOPE=public profile

# --- Our own session JWT (NOT the 42 token). Use a long random string, e.g.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# Key to encrypt the stored 42 user tokens at rest (Fernet). Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# If left empty (or set to an invalid value), a key is derived from JWT_SECRET
# (fine for dev; changing JWT_SECRET then invalidates stored tokens → re-login).
TOKEN_ENCRYPTION_KEY=

# --- Cookies ---
COOKIE_NAME=access_token
# Set COOKIE_SECURE=true in production (HTTPS). SameSite: lax | strict | none.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
# COOKIE_DOMAIN=

# --- Supabase Postgres (PostgreSQL only — no Supabase Auth, no RLS) ---
# Driver is asyncpg. IMPORTANT: do NOT add ?pgbouncer=true — that is a Prisma
# flag and asyncpg rejects it. The app auto-handles the pooler (it disables
# prepared-statement caching for port 6543). ?sslmode=require is also fine
# (translated to asyncpg's ssl option automatically).
#
# DATABASE_URL = runtime (async). Supabase pooled connection (pgbouncer, 6543):
#   postgresql+asyncpg://USER:PASSWORD@HOST:6543/postgres
DATABASE_URL=
# DIRECT_URL = direct connection (port 5432), used by Alembic for migrations:
#   postgresql+asyncpg://USER:PASSWORD@HOST:5432/postgres
DIRECT_URL=

# --- Eventi cache (seconds) to stay under the 42 API hourly quota ---
EVENTS_CACHE_TTL=300

# --- Materiale/Archivio source ---
# Content is read live from the repo's assets/ on GitHub (never mirrored to
# disk; a push updates the site without a redeploy). Accepts "owner/name" or a
# full GitHub URL. A private repo also needs GITHUB_WRITE_TOKEN.
GITHUB_REPO=https://github.com/TioElvis/42-studenti
GITHUB_BRANCH=main
GITHUB_CACHE_TTL=300

# Server token for a PRIVATE repo: a classic PAT with `repo`, or a fine-grained
# token with Contents: Read and write on this repo. When set, the backend both
# READS the private repo AND COMMITS contributions on students' behalf — so no
# per-student GitHub linking and no collaborator invites are needed. Keep it
# only here / in the host env, never in git.
GITHUB_WRITE_TOKEN=

# Comma-separated 42 logins of "special users": they can upload to the ARCHIVE
# and delete files/folders in Materiale and Archivio (Materiale uploads are open
# to any logged-in 42 Roma student). Empty = nobody.
GITHUB_SPECIAL_USERS=

# Per-student contributions instead of a server token (only for a PUBLIC repo):
# a GitHub OAuth App so each student links their own account and opens PRs.
# Leave empty when using GITHUB_WRITE_TOKEN above.
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_SECRET=
GITHUB_OAUTH_CALLBACK_URL=http://localhost:9000/github/link/callback

# Studenti leaderboards: the 42-based boards (wallet, cluster time) are rebuilt in
# the background at most every STATS_REFRESH_SECONDS, for at most STATS_MAX_USERS
# students (2 calls per student per refresh; 42 allows ~1200 calls/hour).
STATS_REFRESH_SECONDS=10800
STATS_MAX_USERS=300
