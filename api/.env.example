# 42-Roma-Studenti API (FastAPI) — copy to api/.env and fill in real values.
# NEVER commit api/.env (it is gitignored).

# --- App ---
ENV=development
PORT=9000
# Where to send the browser after a successful 42 login (the Next.js app).
FRONTEND_URL=http://localhost:3000

# --- 42 OAuth2 (Authorization Code flow). The callback URL must match the one
# registered on your 42 application EXACTLY, character for character. Scope: public.
FORTY_TWO_UID=
FORTY_TWO_SECRET=
FORTY_TWO_CALLBACK_URL=http://localhost:9000/auth/42/callback
# 42 Roma campus id on the Intra (used for the public Eventi feed).
FORTY_TWO_CAMPUS_ID=30
# OAuth scopes requested at login. "profile" is required to register the student
# to events on their behalf (POST /v2/events_users). Changing this forces users
# to log in again to re-consent.
OAUTH_SCOPE=public profile

# --- Our own session JWT (NOT the 42 token). Use a long random string, e.g.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# Key to encrypt the stored 42 user tokens at rest (Fernet). Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# If left empty, a key is derived from JWT_SECRET (fine for dev; changing
# JWT_SECRET would then invalidate stored 42 tokens and require re-login).
TOKEN_ENCRYPTION_KEY=

# --- Cookies ---
COOKIE_NAME=access_token
# Set COOKIE_SECURE=true in production (HTTPS). SameSite: lax | strict | none.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
# COOKIE_DOMAIN=

# --- Supabase Postgres (PostgreSQL only — no Supabase Auth, no RLS) ---
# Driver is asyncpg. IMPORTANT: do NOT add ?pgbouncer=true — that is a Prisma
# flag and asyncpg rejects it. The app auto-handles the pooler (it disables
# prepared-statement caching for port 6543). ?sslmode=require is also fine
# (translated to asyncpg's ssl option automatically).
#
# DATABASE_URL = runtime (async). Supabase pooled connection (pgbouncer, 6543):
#   postgresql+asyncpg://USER:PASSWORD@HOST:6543/postgres
DATABASE_URL=
# DIRECT_URL = direct connection (port 5432), used by Alembic for migrations:
#   postgresql+asyncpg://USER:PASSWORD@HOST:5432/postgres
DIRECT_URL=

# --- Eventi cache (seconds) to stay under the 42 API hourly quota ---
EVENTS_CACHE_TTL=300
